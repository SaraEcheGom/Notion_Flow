<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Teacher.ActivityResultsPage"
             Title="Resultados">
    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0"
                Padding="20,16,20,12"
                Spacing="4"
                BackgroundColor="{StaticResource Primary}">
            <Label x:Name="ActivityTitleLabel"
                   FontSize="18" FontAttributes="Bold" TextColor="White"/>
            <Label x:Name="SummaryLabel"
                   FontSize="13" TextColor="White" Opacity="0.85"/>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="ResultsContainer"
                    Padding="16,12" Spacing="16"/>
        </ScrollView>
    </Grid>
</ContentPage>
