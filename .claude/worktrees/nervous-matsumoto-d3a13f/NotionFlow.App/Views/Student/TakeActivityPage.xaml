<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Student.TakeActivityPage"
             Title="Responder Actividad">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0"
                Padding="20,16,20,12"
                Spacing="4"
                BackgroundColor="{StaticResource AccentTeal}">
            <Label x:Name="ActivityTitleLabel"
                   FontSize="20" FontAttributes="Bold" TextColor="White"/>
            <Label x:Name="ActivityDescLabel"
                   FontSize="13" TextColor="White" Opacity="0.85"/>
            <Label x:Name="ActivityInfoLabel"
                   FontSize="12" TextColor="White" Opacity="0.7"/>
        </VerticalStackLayout>

        <!-- Score Banner (hidden until submitted) -->
        <Border Grid.Row="1"
                x:Name="ScoreBanner"
                IsVisible="False"
                Margin="16,12,16,0"
                Padding="14,10"
                StrokeThickness="0"
                BackgroundColor="#F5F5F5"
                StrokeShape="RoundRectangle 10">
            <Label x:Name="ScoreLabel"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
        </Border>

        <!-- Preguntas -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="QuestionsContainer"
                    Padding="16,12" Spacing="14"/>
        </ScrollView>

        <!-- Submit / Volver -->
        <Button Grid.Row="3"
                x:Name="SubmitButton"
                Text="✅ Enviar respuestas"
                Clicked="OnSubmit"
                BackgroundColor="{StaticResource AccentTeal}"
                TextColor="White"
                CornerRadius="10"
                Padding="0,14"
                Margin="16,12"/>
    </Grid>
</ContentPage>
