<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Student.TakeActivityPage"
             Title="Responder Actividad">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0"
                Padding="{StaticResource SpacingLG},{StaticResource SpacingMD},{StaticResource SpacingLG},{StaticResource SpacingSM}"
                Spacing="{StaticResource SpacingXS}"
                BackgroundColor="{StaticResource AccentTeal}">
            <Label x:Name="ActivityTitleLabel"
                   FontSize="{StaticResource FontSizeLG}" FontAttributes="Bold" TextColor="White"/>
            <Label x:Name="ActivityDescLabel"
                   FontSize="{StaticResource FontSizeXS}" TextColor="White" Opacity="0.85"/>
            <Label x:Name="ActivityInfoLabel"
                   FontSize="{StaticResource FontSizeXXS}" TextColor="White" Opacity="0.7"/>
        </VerticalStackLayout>

        <!-- Score Banner (hidden until submitted) -->
        <Border Grid.Row="1"
                x:Name="ScoreBanner"
                IsVisible="False"
                Margin="{StaticResource SpacingMD},{StaticResource SpacingMD},{StaticResource SpacingMD},0"
                Padding="{StaticResource SpacingMD},{StaticResource SpacingSM}"
                StrokeThickness="0"
                BackgroundColor="#F5F5F5"
                StrokeShape="RoundRectangle {StaticResource RadiusMD}">
            <Label x:Name="ScoreLabel"
                   FontSize="{StaticResource FontSizeMD}"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
        </Border>

        <!-- Preguntas -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="QuestionsContainer"
                    Padding="{StaticResource SpacingMD},{StaticResource SpacingSM}" Spacing="{StaticResource SpacingMD}"/>
        </ScrollView>

        <!-- Submit / Volver -->
        <Button Grid.Row="3"
                x:Name="SubmitButton"
                Text="✅ Enviar respuestas"
                Clicked="OnSubmit"
                BackgroundColor="{StaticResource AccentTeal}"
                TextColor="White"
                CornerRadius="{StaticResource RadiusMD}"
                Padding="0,{StaticResource SpacingMD}"
                Margin="{StaticResource SpacingMD},{StaticResource SpacingSM}"/>
    </Grid>
</ContentPage>
