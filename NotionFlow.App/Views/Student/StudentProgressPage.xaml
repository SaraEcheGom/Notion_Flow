<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Student.StudentProgressPage"
             Title="Mi Progreso"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="16">

            <Label Text="📊 Mi Progreso" Style="{StaticResource Headline}"/>
            
            <Label x:Name="TotalStudentsLabel" FontSize="14" FontAttributes="Bold"/>
            <Label x:Name="TotalActivitiesLabel" FontSize="14" FontAttributes="Bold"/>
            <Label x:Name="AverageLabel" FontSize="14" FontAttributes="Bold"/>

            <Label Text="Estudiantes" FontSize="16" FontAttributes="Bold" Margin="0,20,0,10"/>
            <VerticalStackLayout x:Name="StudentsList" Spacing="10"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>