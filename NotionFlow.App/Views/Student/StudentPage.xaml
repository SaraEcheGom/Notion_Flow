<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Student.StudentPage"
             Title="Mis Cursos"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout x:Name="MainContainer"
                             Padding="20,30,20,30"
                             Spacing="14">

            <!-- Logo + saludo -->
            <Image
                Source="notionflow_logo.png"
                HeightRequest="130"
                Aspect="AspectFit"
                Margin="0,0,0,4"/>

            <Label
                Text="Tus Cursos 📚"
                Style="{StaticResource Headline}"
                HorizontalOptions="Center"/>

            <!-- Botón de Cerrar Sesión -->
            <HorizontalStackLayout HorizontalOptions="End" Margin="0,0,0,10">
                <Button Text="Cerrar Sesión 🚪"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource OutlineBtn}"
                        Padding="14,8"/>
            </HorizontalStackLayout>

            <!-- Lista de Cursos -->
            <CollectionView ItemsSource="{Binding Courses}"
                            EmptyView="Aún no tienes cursos asignados.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource KawaiiCard}" Margin="0,8">
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="10">
                                    <!-- Decorador visual -->
                                    <BoxView WidthRequest="4" 
                                             Color="{StaticResource PrimaryColor}" 
                                             CornerRadius="2"/>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}"
                                               Style="{StaticResource SectionTitle}"/>
                                        <Label Text="{Binding Subject}"
                                               Style="{StaticResource BodyText}"
                                               TextColor="{StaticResource TextMuted}"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>

                                <Label Text="{Binding TeacherName, StringFormat='Profesor: {0}'}"
                                       Style="{StaticResource MutedText}"
                                       Margin="14,4,0,0"/>

                                <!-- Ver curso Botón -->
                                <Button Text="Ir al curso 🎓"
                                        Style="{StaticResource PrimaryBtn}"
                                        HorizontalOptions="Start"
                                        Margin="14,10,0,0"
                                        CommandParameter="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToCourseCommand}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
