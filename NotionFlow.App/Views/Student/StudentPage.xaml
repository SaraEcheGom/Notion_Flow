<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Student.StudentPage"
             Title="Mis Cursos"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Border BackgroundColor="#F9D06A" StrokeThickness="0" Padding="20,28,20,20">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="&#128218;" FontSize="36" HorizontalOptions="Center"/>
                    <Label Text="Tus Cursos" FontSize="22" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="&#161;Bienvenido!" FontSize="12"
                           TextColor="White" Opacity="0.9" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout x:Name="MainContainer" Padding="20,20,20,30" Spacing="14">
                <HorizontalStackLayout HorizontalOptions="End" Margin="0,0,0,10">
                    <Button Text="Cerrar Sesi&#243;n &#128682;"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource OutlineBtn}"
                            Padding="14,8"/>
                </HorizontalStackLayout>
                <CollectionView ItemsSource="{Binding Courses}"
                                EmptyView="A&#250;n no tienes cursos asignados.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource KawaiiCard}" Margin="0,8">
                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="10">
                                        <BoxView WidthRequest="4"
                                                 Color="{StaticResource PrimaryColor}"
                                                 CornerRadius="2"/>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   Style="{StaticResource SectionTitle}"/>
                                            <Label Text="{Binding Subject}"
                                                   Style="{StaticResource BodyText}"
                                                   TextColor="{StaticResource TextMuted}"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding TeacherName, StringFormat='Profesor: {0}'}"
                                           Style="{StaticResource MutedText}"
                                           Margin="14,4,0,0"/>
                                    <Button Text="Ir al curso &#127891;"
                                            Style="{StaticResource PrimaryBtn}"
                                            HorizontalOptions="Start"
                                            Margin="14,10,0,0"
                                            CommandParameter="{Binding .}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToCourseCommand}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
