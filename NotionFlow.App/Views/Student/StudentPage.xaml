<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Student.StudentPage"
             Title="Mis Cursos">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,8" Spacing="4"
                             BackgroundColor="{StaticResource Primary}">
            <Label Text="Mis Cursos"
                   FontSize="22" FontAttributes="Bold"
                   TextColor="White" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="12">

                <Button Text="Cerrar Sesión"
                        Command="{Binding LogoutCommand}"
                        HorizontalOptions="End"
                        BackgroundColor="{StaticResource Gray200}"
                        TextColor="{StaticResource TextDark}"
                        CornerRadius="8"
                        Padding="12,8"/>

                <CollectionView ItemsSource="{Binding Courses}"
                                EmptyView="No tienes cursos asignados.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,5" Padding="15"
                                    StrokeThickness="1" Stroke="{StaticResource Gray300}"
                                    StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold" FontSize="16"/>
                                    <Label Text="{Binding Subject}"
                                           FontSize="13" TextColor="{StaticResource Gray400}"/>
                                    <Label Text="{Binding TeacherName, StringFormat='Profesor: {0}'}"
                                           FontSize="13" TextColor="{StaticResource Gray400}"/>
                                    <Button Text="Ver curso"
                                            Margin="0,8,0,0"
                                            CornerRadius="8"
                                            Padding="12,8"
                                            CommandParameter="{Binding .}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToCourseCommand}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
