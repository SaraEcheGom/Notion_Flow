<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Teacher.AssignActivityPage"
             Title="Asignar Actividad">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0"
                Padding="{StaticResource SpacingLG},{StaticResource SpacingMD}"
                Spacing="{StaticResource SpacingXS}"
                             BackgroundColor="{StaticResource Primary}">
            <Label Text="{Binding ActivityTitle}"
                   FontSize="{StaticResource FontSizeLG}"
                    FontAttributes="Bold"
                    TextColor="White"/>
            <Label Text="Selecciona los estudiantes para asignar esta actividad"
                   FontSize="{StaticResource FontSizeXXS}"
                    TextColor="White"
                    Opacity="0.85"/>
        </VerticalStackLayout>
        <HorizontalStackLayout Grid.Row="1"
                Padding="{StaticResource SpacingLG},{StaticResource SpacingSM}"
                Spacing="{StaticResource SpacingMD}">
            <Button Text="Seleccionar todos"
                    Clicked="OnSelectAll"
                    FontSize="{StaticResource FontSizeXXS}"
                    Padding="10,8"
                    CornerRadius="{StaticResource RadiusSM}"
                    BackgroundColor="{StaticResource Gray200}"
                    TextColor="{StaticResource TextDark}"/>
            <Button Text="Quitar selección"
                    Clicked="OnDeselectAll"
                    FontSize="{StaticResource FontSizeXXS}"
                    Padding="10,8"
                    CornerRadius="{StaticResource RadiusSM}"
                    BackgroundColor="{StaticResource Gray200}"
                    TextColor="{StaticResource TextDark}"/>
        </HorizontalStackLayout>
        <CollectionView Grid.Row="2"
                ItemsSource="{Binding SelectableStudents}"
                        EmptyView="No hay estudiantes matriculados."
                Margin="{StaticResource SpacingLG},0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,{StaticResource SpacingSM}"
                            Padding="{StaticResource SpacingMD}"
                            StrokeThickness="1"
                            Stroke="{StaticResource Gray300}"
                            StrokeShape="RoundRectangle {StaticResource RadiusMD}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0"
                                    Spacing="{StaticResource SpacingXS}"
                                    VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                        FontAttributes="Bold"
                                        FontSize="15"/>
                                <Label Text="{Binding Email}"
                                        FontSize="{StaticResource FontSizeXXS}"
                                        TextColor="{StaticResource Gray400}"/>
                                <Label Text="Ya asignado"
                                        FontSize="{StaticResource FontSizeXS}"
                                        TextColor="{StaticResource AccentTeal}"
                                       IsVisible="{Binding AlreadyAssigned}"/>
                            </VerticalStackLayout>
                            <CheckBox Grid.Column="1"
                                    IsChecked="{Binding IsSelected}"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="3"
                Text="Asignar a seleccionados"
                Clicked="OnAssign"
                BackgroundColor="{StaticResource AccentTeal}"
                TextColor="White"
                CornerRadius="{StaticResource RadiusMD}"
                Padding="0,{StaticResource SpacingMD}"
                Margin="{StaticResource SpacingLG},{StaticResource SpacingSM}"/>
    </Grid>
</ContentPage>