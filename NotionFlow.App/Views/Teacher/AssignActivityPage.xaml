<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Teacher.AssignActivityPage"
             Title="Asignar Actividad">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0"
                Padding="20,16"
                Spacing="4"
                             BackgroundColor="{StaticResource Primary}">
            <Label Text="{Binding ActivityTitle}"
                   FontSize="18"
                    FontAttributes="Bold"
                    TextColor="White"/>
            <Label Text="Selecciona los estudiantes para asignar esta actividad"
                   FontSize="12"
                    TextColor="White"
                    Opacity="0.85"/>
        </VerticalStackLayout>
        <HorizontalStackLayout Grid.Row="1"
                Padding="20,12"
                Spacing="10">
            <Button Text="Seleccionar todos"
                    Clicked="OnSelectAll"
                    FontSize="12"
                    Padding="10,8"
                    CornerRadius="8"
                    BackgroundColor="{StaticResource Gray200}"
                    TextColor="{StaticResource TextDark}"/>
            <Button Text="Quitar selección"
                    Clicked="OnDeselectAll"
                    FontSize="12"
                    Padding="10,8"
                    CornerRadius="8"
                    BackgroundColor="{StaticResource Gray200}"
                    TextColor="{StaticResource TextDark}"/>
        </HorizontalStackLayout>
        <CollectionView Grid.Row="2"
                ItemsSource="{Binding SelectableStudents}"
                        EmptyView="No hay estudiantes matriculados."
                Margin="20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,5"
                            Padding="14"
                            StrokeThickness="1"
                            Stroke="{StaticResource Gray300}"
                            StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                        FontAttributes="Bold"
                                        FontSize="15"/>
                                <Label Text="{Binding Email}"
                                        FontSize="12"
                                        TextColor="{StaticResource Gray400}"/>
                                <Label Text="Ya asignado"
                                        FontSize="11"
                                        TextColor="{StaticResource Teal}"
                                       IsVisible="{Binding AlreadyAssigned}"/>
                            </VerticalStackLayout>
                            <CheckBox Grid.Column="1"
                                    IsChecked="{Binding IsSelected}"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="3"
                Text="Asignar a seleccionados"
                Clicked="OnAssign"
                BackgroundColor="{StaticResource Teal}"
                TextColor="White"
                CornerRadius="10"
                Padding="0,14"
                Margin="20,12"/>
    </Grid>
</ContentPage>