<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NotionFlow.App.Controls"
             x:Class="NotionFlow.App.Views.Teacher.TeacherPage"
             Title="My Courses">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <!-- Header Component -->
        <controls:PageHeaderComponent Grid.Row="0"
                                     Title="My Courses"
                                     Subtitle="Manage your courses" />

        <!-- Content Section -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Padding="20" RowSpacing="15">
            <!-- Action Buttons -->
            <HorizontalStackLayout Grid.Row="0" Spacing="10" HorizontalOptions="FillAndExpand">
                <Button Text="Refresh" 
                        Command="{Binding LoadCoursesCommand}"
                        HorizontalOptions="FillAndExpand" />
                <Button Text="Logout"
                        Command="{Binding LogoutCommand}"
                        HorizontalOptions="FillAndExpand" />
            </HorizontalStackLayout>

            <!-- Courses List -->
            <VerticalStackLayout Grid.Row="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Spacing="10" Padding="0">
                <!-- Debug Label to show course count -->
                <Label Text="{Binding Courses.Count, StringFormat='Total Courses: {0}'}"
                       FontSize="14"
                       TextColor="{StaticResource TextDark}"
                       Margin="0,10,0,0" />

                <!-- Using a ScrollView with a StackLayout for better rendering -->
                <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <VerticalStackLayout x:Name="CoursesContainer" Spacing="8" Padding="0">
                        <!-- Courses will be dynamically added here -->
                    </VerticalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
