<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NotionFlow.App.Views.Teacher.TeacherPage"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- App bar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="20,52,20,14"
              BackgroundColor="{StaticResource PageBackground}">
            <VerticalStackLayout Grid.Column="0" Spacing="1">
                <Label Text="Mis Cursos"
                       Style="{StaticResource SectionTitle}" FontSize="20"/>
                <Label Text="Administra tus cursos y actividades"
                       Style="{StaticResource MutedText}"/>
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="↩ Salir"
                    Command="{Binding LogoutCommand}"
                    Style="{StaticResource OutlineBtn}"
                    Padding="12,6"
                    VerticalOptions="Center"/>
        </Grid>

        <!-- Lista de cursos -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,100" Spacing="10">

                <!-- Indicador de carga -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource PrimaryColor}"
                                   HorizontalOptions="Center"
                                   Margin="0,20"/>

                <!-- Botón refrescar -->
                <Button Text="↺ Refrescar cursos"
                        Command="{Binding LoadCoursesCommand}"
                        Style="{StaticResource OutlineBtn}"
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBusy, Converter={x:StaticResource InvertedBoolConverter}}"/>

                <CollectionView ItemsSource="{Binding Courses}"
                                EmptyView="No tenés cursos asignados aún.">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ItemCard}" Padding="14,12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                    <!-- Ícono -->
                                    <Border Grid.Column="0"
                                            BackgroundColor="{StaticResource InputBackground}"
                                            WidthRequest="44" HeightRequest="44"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12">
                                        <Label Text="📖" FontSize="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="{Binding Name}"
                                               Style="{StaticResource ItemTitle}"/>
                                        <Label Text="{Binding Subject}"
                                               Style="{StaticResource ItemSubtitle}"/>
                                        <Label Text="{Binding Students.Count, StringFormat='🎓 {0} estudiantes'}"
                                               Style="{StaticResource ItemSubtitle}"/>
                                    </VerticalStackLayout>

                                    <!-- Ver detalle -->
                                    <Border Grid.Column="2"
                                            BackgroundColor="{StaticResource InputBackground}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="10,6"
                                            VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewCourseDetailsCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="Ver →" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryDark}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
