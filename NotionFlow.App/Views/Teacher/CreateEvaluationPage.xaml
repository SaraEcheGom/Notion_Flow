<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Teacher.CreateEvaluationPage"
             Title="Nueva Evaluaci&#243;n"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Border BackgroundColor="{StaticResource AccentYellow}"
                    StrokeThickness="0" Padding="20,28,20,20">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="&#128221;" FontSize="36" HorizontalOptions="Center"/>
                    <Label Text="Nueva Evaluaci&#243;n" FontSize="22" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="&#161;Crea una nueva evaluaci&#243;n!" FontSize="12"
                           TextColor="White" Opacity="0.9" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="16,16" Spacing="12">
                <Border Style="{StaticResource KawaiiCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="&#128221; T&#237;tulo" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Entry x:Name="TitleEntry"
                               Placeholder="T&#237;tulo de la evaluaci&#243;n"/>
                        <Label Text="&#128172; Descripci&#243;n" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Editor x:Name="DescriptionEntry"
                                Placeholder="Descripci&#243;n (opcional)"
                                HeightRequest="100"/>
                        <Label Text="&#127919; Porcentaje sobre la nota (%)" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Entry x:Name="PercentageEntry"
                               Placeholder="Ej: 20" Keyboard="Numeric"/>
                        <Button Text="&#127881; Crear Evaluaci&#243;n"
                                Clicked="OnSave"
                                Style="{StaticResource PrimaryBtn}"
                                Margin="0,6,0,0"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
