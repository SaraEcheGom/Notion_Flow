<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Teacher.CreateEvaluationPage"
             Title="Nueva Evaluación">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Nueva Evaluación"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,8"/>

            <Label Text="Título *"
                   FontSize="14"
                   FontAttributes="Bold"/>
            <Entry x:Name="TitleEntry"
                   Placeholder="Nombre de la evaluación"/>

            <Label Text="Descripción"
                   FontSize="14"
                   FontAttributes="Bold"/>
            <Editor x:Name="DescriptionEditor"
                    Placeholder="Descripción opcional"
                    HeightRequest="90"/>

            <Label Text="Porcentaje sobre la nota (%) *"
                   FontSize="14"
                   FontAttributes="Bold"/>
            <Entry x:Name="PercentageEntry"
                   Placeholder="Ej: 30"
                   Keyboard="Numeric"/>

            <Label Text="Fecha de la evaluación *"
                   FontSize="14"
                   FontAttributes="Bold"/>
            <DatePicker x:Name="EvalDatePicker"
                        Format="dd/MM/yyyy"
                        MinimumDate="01/01/2020"/>

            <Button x:Name="SaveButton"
                    Text="Crear Evaluación"
                    Clicked="OnSave"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="10"
                    Padding="0,14"
                    Margin="0,12,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
