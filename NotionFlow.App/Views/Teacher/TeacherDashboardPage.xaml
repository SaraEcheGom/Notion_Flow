<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Teacher.TeacherDashboardPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="20,52,20,20"
                             Spacing="8"
                             BackgroundColor="{StaticResource PageBackground}">
            <Label Text="Dashboard"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextDark}"/>
            <Label Text="Resumen de tu actividad"
                   FontSize="12"
                   TextColor="{StaticResource TextMuted}"/>
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,12,20,100" Spacing="16">

                <!-- Loading -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource PrimaryColor}"/>

                <!-- Stats Grid -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12"
                      IsVisible="{Binding IsBusy, Converter={x:StaticResource InvertedBoolConverter}}">

                    <!-- Total Cursos -->
                    <Border Grid.Row="0" Grid.Column="0"
                            BackgroundColor="{StaticResource Primary}"
                            Padding="16,20"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding TotalCourses}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="Cursos"
                                   FontSize="12"
                                   TextColor="White"
                                   Opacity="0.85"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Total Estudiantes -->
                    <Border Grid.Row="0" Grid.Column="1"
                            BackgroundColor="{StaticResource AccentTeal}"
                            Padding="16,20"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding TotalStudents}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="Estudiantes"
                                   FontSize="12"
                                   TextColor="White"
                                   Opacity="0.85"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Evaluaciones Pendientes -->
                    <Border Grid.Row="1" Grid.Column="0"
                            BackgroundColor="#FF9800"
                            Padding="16,20"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding PendingEvaluations}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="Evaluaciones"
                                   FontSize="12"
                                   TextColor="White"
                                   Opacity="0.85"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Actividades Activas -->
                    <Border Grid.Row="1" Grid.Column="1"
                            BackgroundColor="#9C27B0"
                            Padding="16,20"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding ActiveActivities}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="Actividades"
                                   FontSize="12"
                                   TextColor="White"
                                   Opacity="0.85"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Recent Activities Section -->
                <VerticalStackLayout Spacing="8"
                                     IsVisible="{Binding IsBusy, Converter={x:StaticResource InvertedBoolConverter}}">
                    <Label Text="Cursos activos"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextDark}"/>

                    <CollectionView ItemsSource="{Binding RecentCourses}"
                                    EmptyView="Sin cursos asignados.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10"
                                        Margin="0,4"
                                        BackgroundColor="{StaticResource InputBackground}"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource Gray200}"
                                        StrokeShape="RoundRectangle 8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   TextColor="{StaticResource TextDark}"/>
                                            <Label Text="{Binding Subject}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource TextMuted}"/>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="{Binding Students.Count, StringFormat='👥 {0}'}"
                                               VerticalOptions="Center"
                                               FontSize="12"
                                               TextColor="{StaticResource PrimaryDark}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Quick Actions -->
                <VerticalStackLayout Spacing="8"
                                     IsVisible="{Binding IsBusy, Converter={x:StaticResource InvertedBoolConverter}}">
                    <Label Text="Acciones rápidas"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextDark}"/>

                    <Button Text="📊 Ver Evaluaciones"
                            Command="{Binding ViewEvaluationsCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="12,12"/>

                    <Button Text="📝 Ver Actividades"
                            Command="{Binding ViewActivitiesCommand}"
                            BackgroundColor="{StaticResource AccentTeal}"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="12,12"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>