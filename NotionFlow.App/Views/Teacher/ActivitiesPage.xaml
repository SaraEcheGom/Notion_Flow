<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Teacher.ActivitiesPage"
             Title="Actividades"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Border BackgroundColor="{StaticResource PrimaryColor}"
                    StrokeThickness="0" Padding="20,28,20,20">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="&#127919;" FontSize="36" HorizontalOptions="Center"/>
                    <Label Text="Actividades" FontSize="22" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="{Binding CourseName}" FontSize="12"
                           TextColor="White" Opacity="0.9" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="16,16" Spacing="12">

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="&#43; Nueva Actividad"
                            Command="{Binding CreateActivityCommand}"
                            Style="{StaticResource PrimaryBtn}"/>
                    <Button Grid.Column="1" Text="&#8635; Actualizar"
                            Command="{Binding LoadActivitiesCommand}"
                            Style="{StaticResource OutlineBtn}"/>
                </Grid>

                <Border BackgroundColor="#e0f8ee" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14" Padding="12,10">
                    <Label Text="&#127919; Actividades creadas" FontSize="14"
                           FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}"/>
                </Border>

                <CollectionView ItemsSource="{Binding Activities}"
                                EmptyView="No hay actividades creadas a&#250;n.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource KawaiiCard}" Margin="0,6"
                                    StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Title}" FontAttributes="Bold"
                                           FontSize="15" TextColor="{StaticResource TextDark}"/>
                                    <Label Text="{Binding Description}" FontSize="12"
                                           TextColor="{StaticResource TextMuted}"/>
                                    <Label Text="{Binding PercentageValue, StringFormat='Valor: {0}%'}"
                                           FontSize="12" TextColor="{StaticResource PrimaryDark}"/>
                                    <Label Text="{Binding DueDate, StringFormat='Fecha l&#237;mite: {0:dd/MM/yyyy}'}"
                                           FontSize="12" TextColor="{StaticResource TextMuted}"/>
                                    <Label Text="{Binding Questions.Count, StringFormat='Preguntas: {0}'}"
                                           FontSize="11" TextColor="{StaticResource PrimaryColor}"/>
                                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                        <Button Text="&#9999; Editar" FontSize="12"
                                                Padding="12,8" CornerRadius="10"
                                                BackgroundColor="{StaticResource PrimaryColor}"
                                                TextColor="White"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditActivityCommand}"/>
                                        <Button Text="&#128101; Asignar" FontSize="12"
                                                Padding="12,8" CornerRadius="10"
                                                BackgroundColor="{StaticResource AccentLavender}"
                                                TextColor="White"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AssignActivityCommand}"/>
                                        <Button Text="&#128465; Eliminar" FontSize="12"
                                                Padding="12,8" CornerRadius="10"
                                                BackgroundColor="{StaticResource AccentPink}"
                                                TextColor="White"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteActivityCommand}"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
