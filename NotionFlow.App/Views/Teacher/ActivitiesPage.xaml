<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Teacher.ActivitiesPage"
             Title="Actividades del Curso">
    <Grid RowDefinitions="Auto,*"
            RowSpacing="0">
        <VerticalStackLayout Grid.Row="0"
                Padding="{StaticResource SpacingLG},{StaticResource SpacingMD},{StaticResource SpacingLG},{StaticResource SpacingSM}"
                Spacing="{StaticResource SpacingXS}"
                             BackgroundColor="{StaticResource Primary}">
            <Label Text="{Binding CourseName}"
                   FontSize="{StaticResource FontSizeLG}"
                    FontAttributes="Bold"
                    TextColor="White"/>
            <Label Text="Gestión de actividades"
                   FontSize="{StaticResource FontSizeXS}"
                    TextColor="White"
                    Opacity="0.85"/>
        </VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource SpacingLG}"
                    Spacing="{StaticResource SpacingMD}">
                <Button Text="+ Nueva Actividad (Cuestionario)"
                        Command="{Binding CreateActivityCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="{StaticResource RadiusMD}"
                        Padding="0,{StaticResource SpacingMD}"/>
                <Button Text="Generar cuestionario desde foto"
                        Command="{Binding GenerateQuizCommand}"
                        BackgroundColor="{StaticResource AccentTeal}"
                        TextColor="White"
                        CornerRadius="{StaticResource RadiusMD}"
                        Padding="0,{StaticResource SpacingMD}"/>
                <Button Text="↻ Actualizar"
                        Command="{Binding LoadActivitiesCommand}"
                        BackgroundColor="{StaticResource Gray200}"
                        TextColor="{StaticResource TextDark}"
                        CornerRadius="{StaticResource RadiusMD}"
                        Padding="0,{StaticResource SpacingSM}"/>
                <Label Text="Actividades creadas"
                       FontSize="{StaticResource FontSizeMD}"
                        FontAttributes="Bold"
                        Margin="0,{StaticResource SpacingSM},0,0"/>
                <CollectionView ItemsSource="{Binding Activities}"
                                EmptyView="No hay actividades creadas aún.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,{StaticResource SpacingMD}"
                                    Padding="{StaticResource SpacingLG}"
                                    StrokeThickness="1.5"
                                    Stroke="{StaticResource Gray300}"
                                    StrokeShape="RoundRectangle {StaticResource RadiusMD}">
                                <VerticalStackLayout Spacing="{StaticResource SpacingMD}">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                            FontSize="{StaticResource FontSizeMD}"
                                           TextColor="{StaticResource TextDark}"/>
                                    <Label Text="{Binding Description}"
                                           FontSize="{StaticResource FontSizeXS}"
                                            TextColor="{StaticResource Gray400}"/>
                                    <Label Text="{Binding PercentageValue, StringFormat='Valor: {0}%'}"
                                           FontSize="{StaticResource FontSizeXS}"/>
                                    <Label Text="{Binding DueDate, StringFormat='Fecha límite: {0:dd/MM/yyyy}'}"
                                           FontSize="{StaticResource FontSizeXS}"
                                            TextColor="{StaticResource Gray400}"/>
                                    <Label Text="{Binding Questions.Count, StringFormat='Preguntas: {0}'}"
                                           FontSize="{StaticResource FontSizeXXS}"
                                            TextColor="{StaticResource Primary}"/>
                                    <HorizontalStackLayout Spacing="{StaticResource SpacingSM}"
                                            Margin="0,{StaticResource SpacingMD},0,0">
                                        <Button Text="✏ Editar"
                                                FontSize="{StaticResource FontSizeXXS}"
                                                Padding="12,8"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditActivityCommand}"/>
                                        <Button Text="👤 Asignar"
                                                FontSize="{StaticResource FontSizeXXS}"
                                                Padding="12,8"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                BackgroundColor="{StaticResource AccentTeal}"
                                                TextColor="White"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AssignActivityCommand}"/>
                                        <Button Text="🗑 Eliminar"
                                                FontSize="{StaticResource FontSizeXXS}"
                                                Padding="12,8"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                BackgroundColor="{StaticResource DeleteColor}"
                                                TextColor="White"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteActivityCommand}"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>