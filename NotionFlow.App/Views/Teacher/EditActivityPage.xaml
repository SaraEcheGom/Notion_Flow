<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Teacher.EditActivityPage"
             Title="Editar Actividad">
    <ScrollView>
        <VerticalStackLayout Padding="20"
                Spacing="14">
            <Label Text="Editar Actividad"
                    FontSize="22"
                    FontAttributes="Bold"
                   HorizontalOptions="Center"
                    Margin="0,0,0,8"/>
            <Label Text="Título *"
                    FontSize="14"
                    FontAttributes="Bold"/>
            <Entry x:Name="TitleEntry"
                    Placeholder="Nombre de la actividad"/>
            <Label Text="Descripción"
                    FontSize="14"
                    FontAttributes="Bold"/>
            <Editor x:Name="DescriptionEditor"
                    Placeholder="Descripción (opcional)"
                    HeightRequest="80"/>
            <Label Text="Porcentaje sobre la nota (%) *"
                    FontSize="14"
                    FontAttributes="Bold"/>
            <Entry x:Name="PercentageEntry"
                    Placeholder="Ej: 20"
                    Keyboard="Numeric"/>
            <Label Text="Fecha límite *"
                    FontSize="14"
                    FontAttributes="Bold"/>
            <DatePicker x:Name="DueDatePicker"
                    Format="dd/MM/yyyy"/>
            <BoxView HeightRequest="1"
                    BackgroundColor="{StaticResource Gray300}"
                    Margin="0,8"/>
            <HorizontalStackLayout>
                <Label Text="Preguntas"
                        FontSize="18"
                        FontAttributes="Bold"
                       VerticalOptions="Center"
                        HorizontalOptions="FillAndExpand"/>
                <Button Text="+ Agregar Pregunta"
                        Clicked="OnAddQuestion"
                        FontSize="13"
                        Padding="12,8"
                        CornerRadius="8"/>
            </HorizontalStackLayout>
            <VerticalStackLayout x:Name="QuestionsContainer"
                    Spacing="12"/>
            <Button Text="Guardar Cambios"
                    Clicked="OnSave"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="10"
                    Padding="0,14"
                    Margin="0,12,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
