<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Teacher.PublishContentPage"
             Title="Publicar Contenido"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Border BackgroundColor="{StaticResource AccentLavender}"
                    StrokeThickness="0" Padding="20,28,20,20">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="&#128206;" FontSize="36" HorizontalOptions="Center"/>
                    <Label Text="Nuevo Contenido" FontSize="22" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="&#161;Comparte material con tus alumnos!" FontSize="12"
                           TextColor="White" Opacity="0.9" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="16,16" Spacing="12">
                <Border Style="{StaticResource KawaiiCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="&#128221; T&#237;tulo" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Entry x:Name="TitleEntry"
                               Placeholder="T&#237;tulo del contenido"/>
                        <Label Text="&#128172; Descripci&#243;n" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Editor x:Name="DescriptionEntry"
                                Placeholder="Descripci&#243;n del contenido"
                                HeightRequest="100"/>
                        <Label Text="&#127919; Tipo de contenido" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Picker x:Name="TypePicker" Title="Selecciona el tipo">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Video</x:String>
                                    <x:String>Documento</x:String>
                                    <x:String>Imagen</x:String>
                                    <x:String>Enlace</x:String>
                                    <x:String>Otro</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                        <Label Text="&#127760; URL o ruta" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Entry x:Name="UrlEntry"
                               Placeholder="https://ejemplo.com/recurso"
                               Keyboard="Url"/>
                        <Button Text="&#127881; Publicar contenido"
                                Clicked="OnPublish"
                                Style="{StaticResource PrimaryBtn}"
                                Margin="0,6,0,0"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
