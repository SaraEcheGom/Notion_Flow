<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Admin.CreateTeacherPage"
             Title="Nuevo Profesor"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Border BackgroundColor="#6BAADD"
                    StrokeThickness="0" Padding="20,28,20,20">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="&#128105;&#8205;&#127979;" FontSize="36" HorizontalOptions="Center"/>
                    <Label Text="Nuevo Profesor" FontSize="22" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="&#161;Registra un nuevo docente!" FontSize="12"
                           TextColor="White" Opacity="0.9" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="16,16" Spacing="12">
                <Border Style="{StaticResource KawaiiCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="&#128522; Nombre completo" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Entry Placeholder="Nombre y apellido"
                               Text="{Binding TeacherName}"/>
                        <Label Text="&#128231; Correo electr&#243;nico" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Entry Placeholder="correo@ejemplo.com"
                               Text="{Binding TeacherEmail}" Keyboard="Email"/>
                        <Label Text="&#128274; Contrase&#241;a" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Entry Placeholder="Contrase&#241;a segura"
                               Text="{Binding TeacherPassword}" IsPassword="True"/>
                        <Button Text="&#127881; Crear Profesor"
                                Command="{Binding CreateTeacherCommand}"
                                Style="{StaticResource PrimaryBtn}"
                                Margin="0,6,0,0"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


