<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Auth.RegisterPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Border BackgroundColor="{StaticResource AccentLavender}"
                    StrokeThickness="0" Padding="24,32,24,24">
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="&#127881;" FontSize="44" HorizontalOptions="Center"/>
                    <Label Text="Crear cuenta" FontSize="24" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="&#161;&#218;nete a Notion Flow!"
                           FontSize="12" TextColor="White" Opacity="0.9"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout Padding="20,24" Spacing="14">
                <Border Style="{StaticResource KawaiiCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="&#128522; Nombre completo" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Entry Placeholder="Nombre y apellido" Text="{Binding Nombre}"/>
                        <Label Text="&#128231; Correo electr&#243;nico" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Entry Placeholder="correo@ejemplo.com" Text="{Binding Email}" Keyboard="Email"/>
                        <Label Text="&#128274; Contrase&#241;a" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Entry Placeholder="Contrase&#241;a segura" Text="{Binding Password}" IsPassword="True"/>
                        <Label Text="&#127917; Tipo de cuenta" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Picker Title="Selecciona un rol"
                                ItemsSource="{Binding Roles}"
                                SelectedItem="{Binding RolSeleccionado}"/>
                        <Entry Placeholder="Token de autorizaci&#243;n"
                               Text="{Binding Token}" IsPassword="True"
                               IsVisible="{Binding MostrarToken}"/>
                        <Label Text="Se requiere token para Profesor o Admin"
                               TextColor="{StaticResource TextMuted}" FontSize="11"
                               IsVisible="{Binding MostrarToken}"/>
                        <Button Text="&#161;Registrarse!"
                                Command="{Binding RegisterCommand}"
                                Style="{StaticResource PrimaryBtn}"
                                Margin="0,6,0,0"/>
                    </VerticalStackLayout>
                </Border>
                <Label Text="NotionFlow &#169; 2026" FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
