<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Auth.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Header gradiente -->
            <Border BackgroundColor="{StaticResource PrimaryColor}"
                    StrokeThickness="0" Padding="24,32,24,24">
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="🌿" FontSize="44" HorizontalOptions="Center"/>
                    <Label Text="Notion Flow" FontSize="26" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Organiza · Aprende · Crea · Brilla"
                           FontSize="12" TextColor="White" Opacity="0.9"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="20,24" Spacing="14">
                <Border Style="{StaticResource KawaiiCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="📧 Correo electrónico" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Entry Placeholder="correo@ejemplo.com"
                               Text="{Binding Email}" Keyboard="Email"/>
                        <Label Text="🔒 Contraseña" FontSize="12"
                               FontAttributes="Bold" TextColor="{StaticResource TextMuted}"/>
                        <Entry Placeholder="••••••••"
                               Text="{Binding Password}" IsPassword="True"/>
                        <Button Text="¡Entrar! 🚀"
                                Command="{Binding LoginCommand}"
                                Style="{StaticResource PrimaryBtn}"
                                Margin="0,6,0,0"/>
                        <Button Text="Crear cuenta nueva ✨"
                                Command="{Binding GoToRegisterCommand}"
                                Style="{StaticResource OutlineBtn}"/>
                    </VerticalStackLayout>
                </Border>
                <Label Text="NotionFlow © 2026" FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
