<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Auth.UserProfilePage"
             Title="Mi Perfil"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Border BackgroundColor="{StaticResource AccentPink}"
                    StrokeThickness="0" Padding="20,28,20,24">
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Border BackgroundColor="rgba(255,255,255,0.25)"
                            StrokeThickness="2" Stroke="White"
                            StrokeShape="RoundRectangle 40"
                            WidthRequest="72" HeightRequest="72"
                            HorizontalOptions="Center">
                        <Label Text="{Binding Initial}" FontSize="28"
                               FontAttributes="Bold" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="{Binding Role}" FontSize="12"
                           TextColor="White" Opacity="0.9" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="16,16" Spacing="12">

                <Border Style="{StaticResource KawaiiCard}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="&#128231; Correo electr&#243;nico" FontSize="12"
                               TextColor="{StaticResource TextMuted}"/>
                        <Label Text="{Binding Email}" FontSize="15"
                               FontAttributes="Bold" TextColor="{StaticResource TextDark}"/>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#e0f8ee" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14" Padding="12,10">
                    <Label Text="&#128218; Cursos asignados" FontSize="14"
                           FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}"/>
                </Border>

                <CollectionView ItemsSource="{Binding Courses}"
                                EmptyView="Sin cursos asignados.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource KawaiiCard}" Margin="0,4"
                                    StrokeShape="RoundRectangle 12">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Grid.Column="0" BackgroundColor="#e0f8ee"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                            WidthRequest="36" HeightRequest="36">
                                        <Label Text="&#128218;" FontSize="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold"
                                               FontSize="13" TextColor="{StaticResource TextDark}"/>
                                        <Label Text="{Binding Subject}" FontSize="11"
                                               TextColor="{StaticResource TextMuted}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
