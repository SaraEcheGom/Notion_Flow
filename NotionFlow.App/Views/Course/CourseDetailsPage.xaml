<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotionFlow.App.Views.Course.CourseDetailsPage"
             Title="Detalles del Curso"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Border BackgroundColor="{StaticResource PrimaryColor}"
                    StrokeThickness="0" Padding="20,28,20,20">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="&#128216;" FontSize="36" HorizontalOptions="Center"/>
                    <Label Text="{Binding CourseName}" FontSize="20" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="{Binding Subject}" FontSize="12"
                           TextColor="White" Opacity="0.9" HorizontalOptions="Center"/>
                    <Label Text="{Binding TeacherName, StringFormat='&#128105;&#8205;&#127979; {0}'}"
                           FontSize="12" TextColor="White" Opacity="0.85"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="16,16" Spacing="12">

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" BackgroundColor="#e0f8ee"
                            StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="8">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding Students.Count}" FontSize="20"
                                   FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}"
                                   HorizontalOptions="Center"/>
                            <Label Text="&#127891; Estud." FontSize="10"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="#f3e0ff"
                            StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="8">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="&#10024;" FontSize="20" HorizontalOptions="Center"/>
                            <Label Text="Activo" FontSize="10"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="#fff5d0"
                            StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="8">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="&#128218;" FontSize="20" HorizontalOptions="Center"/>
                            <Label Text="Curso" FontSize="10"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border BackgroundColor="#e0f8ee" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14" Padding="12,10">
                    <Label Text="&#127891; Estudiantes del curso" FontSize="14"
                           FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}"/>
                </Border>

                <CollectionView ItemsSource="{Binding Students}"
                                EmptyView="Ning&#250;n estudiante asignado.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource KawaiiCard}" Margin="0,4"
                                    StrokeShape="RoundRectangle 12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" BackgroundColor="#ffe0ec"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 20"
                                            WidthRequest="38" HeightRequest="38">
                                        <Label Text="&#127891;" FontSize="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold"
                                               FontSize="13" TextColor="{StaticResource TextDark}"/>
                                        <Label Text="{Binding Email}" FontSize="11"
                                               TextColor="{StaticResource TextMuted}"/>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2" Text="Quitar"
                                            CommandParameter="{Binding .}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveStudentCommand}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanRemoveStudents}"
                                            BackgroundColor="{StaticResource AccentPink}"
                                            TextColor="White" CornerRadius="10"
                                            Padding="10,6" FontSize="11"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="&#8592; Volver &#127968;"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource OutlineBtn}"
                        Margin="0,8,0,0"/>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
