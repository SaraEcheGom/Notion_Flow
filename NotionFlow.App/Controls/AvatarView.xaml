<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NotionFlow.App.Controls.AvatarView"
    x:Name="this">

    <!--
        Uso:
        <controls:AvatarView Initials="MG" Size="42" />

        BindableProperties: Initials (string), Size (double)
        El fondo usa InputBackground y el texto PrimaryDark del ResourceDictionary.
    -->
    <Border
        BackgroundColor="{StaticResource InputBackground}"
        StrokeThickness="0"
        WidthRequest="{Binding Size, Source={x:Reference this}}"
        HeightRequest="{Binding Size, Source={x:Reference this}}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{Binding HalfSize, Source={x:Reference this}}" />
        </Border.StrokeShape>
        <Label
            Text="{Binding Initials, Source={x:Reference this}}"
            FontSize="{Binding FontSz, Source={x:Reference this}}"
            FontAttributes="Bold"
            TextColor="{StaticResource PrimaryDark}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Border>
</ContentView>
