<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ================================================ -->
    <!--  PALETA NOTIONFLOW — Crema + Verde Pastel         -->
    <!-- ================================================ -->

    <!-- Fondos -->
    <Color x:Key="PageBackground">#FBF8EF</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="InputBackground">#EEF9F3</Color>

    <!-- Verde pastel — color principal -->
    <Color x:Key="PrimaryColor">#5BBF8A</Color>
    <Color x:Key="PrimaryDark">#2E8A5E</Color>
    <Color x:Key="PrimaryLight">#C8F0DC</Color>
    <Color x:Key="PrimaryBorder">#90D4B0</Color>

    <!-- Acentos -->
    <Color x:Key="AccentPink">#F4A0C0</Color>
    <Color x:Key="AccentYellow">#F9D06A</Color>
    <Color x:Key="AccentOrange">#F4A940</Color>
    <Color x:Key="AccentLavender">#C084F5</Color>

    <!-- Texto -->
    <Color x:Key="TextDark">#1A4A32</Color>
    <Color x:Key="TextMuted">#5A9A72</Color>
    <Color x:Key="TextLight">#90D4B0</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>

    <!-- Bordes -->
    <Color x:Key="BorderLight">#90D4B0</Color>
    <Color x:Key="BorderMedium">#5BBF8A</Color>

    <!-- Estados -->
    <Color x:Key="SuccessColor">#5BBF8A</Color>
    <Color x:Key="WarningColor">#F9D06A</Color>
    <Color x:Key="DangerColor">#F4A0C0</Color>
    <Color x:Key="ErrorColor">#F4A0C0</Color>
    <Color x:Key="DeleteColor">#E53935</Color>

    <!-- Teal — color complementario (alias o color independiente) -->
    <Color x:Key="Teal">#20B2AA</Color>
    <Color x:Key="AccentTeal">#20B2AA</Color>

    <!-- ================================================ -->
    <!--  Colores internos MAUI — NO borrar               -->
    <!-- ================================================ -->
    <Color x:Key="Primary">#5BBF8A</Color>
    <Color x:Key="PrimaryDarkText">#1A4A32</Color>
    <Color x:Key="Secondary">#F4A0C0</Color>
    <Color x:Key="SecondaryDarkText">#1A4A32</Color>
    <Color x:Key="Tertiary">#F9D06A</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="OffBlackBrush" Color="{StaticResource OffBlack}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- ================================================ -->
    <!--  TOKENS DE TIPOGRAFÍA                            -->
    <!-- ================================================ -->
    <x:Double x:Key="FontSizeXL">24</x:Double>
    <x:Double x:Key="FontSizeLG">20</x:Double>
    <x:Double x:Key="FontSizeMD">16</x:Double>
    <x:Double x:Key="FontSizeSM">14</x:Double>
    <x:Double x:Key="FontSizeXS">13</x:Double>
    <x:Double x:Key="FontSizeXXS">12</x:Double>

    <!-- ================================================ -->
    <!--  TOKENS DE ESPACIADO                             -->
    <!-- ================================================ -->
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingSM">8</x:Double>
    <x:Double x:Key="SpacingMD">14</x:Double>
    <x:Double x:Key="SpacingLG">20</x:Double>
    <x:Double x:Key="SpacingXL">32</x:Double>

    <!-- ================================================ -->
    <!--  TOKENS DE BORDER RADIUS                         -->
    <!-- ================================================ -->
    <x:Double x:Key="RadiusSM">8</x:Double>
    <x:Double x:Key="RadiusMD">16</x:Double>
    <x:Double x:Key="RadiusLG">22</x:Double>
    <x:Double x:Key="RadiusXL">32</x:Double>
</ResourceDictionary>